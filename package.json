{
  "name": "ranking-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && npx prisma db push --accept-data-loss && node scripts/migrate-to-multilocale.js && next build",
    "start": "next start",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node scripts/seed.js",
    "cron": "node scripts/cron.js",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^140.0.0",
    "lucide-react": "^1.7.0",
    "next": "^14.2.0",
    "node-cron": "^3.0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "serpapi": "^2.2.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.2.4",
    "postcss": "^8.5.8",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  }
}
